+/// The point operations that the ladder runs, over a curve's projective
+/// points (`Self`) and the affine points of its tables ([`LadderOps::Affine`]).
+///
+/// The ladder ([`add_digit`]) and the entry points ([`mul_glv_with`] and the
+/// other `_with` functions) are written once over this trait and [`GlvOps`],
+/// rather than over [`GlvParams`] and the curve traits that it extends, so that
+/// Aeneas can translate them; every [`GlvParams`] curve implements both traits
+/// with its own operations. ([`Table::batch`] keeps its own body: Aeneas'
+/// library does not model its `map` and `collect`.) As
+/// `crate::inversion::InvertBlocks` does for the inversion, this trait mirrors
+/// the Lean record of the same name.
+trait LadderOps: Sized {
+    /// The affine form of a point.
+    type Affine: Copy;
+
+    /// `C::identity()`.
+    fn identity() -> Self;
+
+    /// `p.double()`.
+    fn double(p: &Self) -> Self;
+
+    /// `*acc += a` for an affine `a` (a mixed addition).
+    fn add_mixed(acc: &mut Self, a: Self::Affine);
+
+    /// `-a` for an affine `a`.
+    fn neg_affine(a: Self::Affine) -> Self::Affine;
+}
+
+/// The curve operations that the rest of the GLV path runs, beside those of
+/// [`LadderOps`]: those of the table builders and of [`GlvParams::mul_glv`]
+/// (the Lean record `CurveOps`), and the decomposition of a scalar. It also
+/// builds and reads a [`Table`] and a [`Decomposed`], so that each function
+/// written over it keeps the signature, and the machine code, of the method
+/// that calls it.
+trait GlvOps: LadderOps + Copy {
+    /// The scalar field, `C::ScalarExt`.
+    type Scalar;
+
+    /// [`Table`].
+    type Table;
+
+    /// [`Decomposed`].
+    type Decomposed;
+
+    /// `bool::from(p.is_identity())`.
+    fn is_identity(p: &Self) -> bool;
+
+    /// `p + q`.
+    fn add(p: Self, q: Self) -> Self;
+
+    /// `p.endo()` (see [`CurveExt::endo`]).
+    fn endo(p: &Self) -> Self;
+
+    /// `C::AffineExt::identity()`.
+    fn affine_identity() -> Self::Affine;
+
+    /// `C::batch_normalize(p, q)`.
+    fn batch_normalize(p: &[Self], q: &mut [Self::Affine]);
+
+    /// `decompose::<C>(k)` (see [`decompose`]).
+    fn decompose(k: &Self::Scalar) -> ((bool, u128), (bool, u128));
+
+    /// The table with the halves `t1` and `t2`.
+    fn table(t1: [Self::Affine; 4], t2: [Self::Affine; 4]) -> Self::Table;
+
+    /// The halves `(t1, t2)` of the table `t`.
+    fn halves(t: &Self::Table) -> (&[Self::Affine; 4], &[Self::Affine; 4]);
+
+    /// The [`Decomposed`] with these fields.
+    fn decomposed(
+        digits1: [i8; MAX_WNAF_DIGITS],
+        digits2: [i8; MAX_WNAF_DIGITS],
+        len: usize,
+    ) -> Self::Decomposed;
+
+    /// The fields `(digits1, digits2, len)` of `k`.
+    fn digits(k: &Self::Decomposed) -> (&[i8; MAX_WNAF_DIGITS], &[i8; MAX_WNAF_DIGITS], usize);
+}
+
+impl<C: GlvParams> LadderOps for C {
+    type Affine = C::AffineExt;
+
+    #[inline]
+    fn identity() -> Self {
+        C::identity()
+    }
+
+    #[inline]
+    fn double(p: &Self) -> Self {
+        p.double()
+    }
+
+    #[inline]
+    fn add_mixed(acc: &mut Self, a: Self::Affine) {
+        *acc += a;
+    }
+
+    #[inline]
+    fn neg_affine(a: Self::Affine) -> Self::Affine {
+        -a
+    }
+}
+
+impl<C: GlvParams> GlvOps for C {
+    type Scalar = C::ScalarExt;
+    type Table = Table<C>;
+    type Decomposed = Decomposed<C>;
+
+    #[inline]
+    fn is_identity(p: &Self) -> bool {
+        bool::from(p.is_identity())
+    }
+
+    #[inline]
+    fn add(p: Self, q: Self) -> Self {
+        p + q
+    }
+
+    #[inline]
+    fn endo(p: &Self) -> Self {
+        p.endo()
+    }
+
+    #[inline]
+    fn affine_identity() -> Self::Affine {
+        C::AffineExt::identity()
+    }
+
+    #[inline]
+    fn batch_normalize(p: &[Self], q: &mut [Self::Affine]) {
+        C::batch_normalize(p, q);
+    }
+
+    #[inline]
+    fn decompose(k: &Self::Scalar) -> ((bool, u128), (bool, u128)) {
+        decompose::<C>(k)
+    }
+
+    #[inline]
+    fn table(t1: [Self::Affine; 4], t2: [Self::Affine; 4]) -> Self::Table {
+        Table { t1, t2 }
+    }
+
+    #[inline]
+    fn halves(t: &Self::Table) -> (&[Self::Affine; 4], &[Self::Affine; 4]) {
+        (&t.t1, &t.t2)
+    }
+
+    #[inline]
+    fn decomposed(
+        digits1: [i8; MAX_WNAF_DIGITS],
+        digits2: [i8; MAX_WNAF_DIGITS],
+        len: usize,
+    ) -> Self::Decomposed {
+        Decomposed {
+            digits1,
+            digits2,
+            len,
+            _curve: core::marker::PhantomData,
+        }
+    }
+
+    #[inline]
+    fn digits(k: &Self::Decomposed) -> (&[i8; MAX_WNAF_DIGITS], &[i8; MAX_WNAF_DIGITS], usize) {
+        (&k.digits1, &k.digits2, k.len)
+    }
 }
 
+/// [`GlvParams::mul_glv`] over the curve operations `G`.
+fn mul_glv_with<G: GlvOps>(p: &G, k: &G::Scalar) -> G {
+    if G::is_identity(p) {
+        // k*O = O. Identity tables work (see [`Table::batch`]), but
+        // building one still costs a field inversion; short-circuit.
+        return G::identity();
+    }
+    table_mul_with::<G>(&table_new_with(p), k)
+}
