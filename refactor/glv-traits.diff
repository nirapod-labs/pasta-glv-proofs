+/// [`Decomposed::new`] over the curve operations `G`.
+fn decomposed_new_with<G: GlvOps>(k: &G::Scalar) -> G::Decomposed {
+    let ((neg1, a1), (neg2, a2)) = G::decompose(k);
+    let (digits1, len1) = wnaf_digits(a1, neg1);
+    let (digits2, len2) = wnaf_digits(a2, neg2);
+    G::decomposed(digits1, digits2, len1.max(len2))
+}
