+/// The eight projective window entries for one point:
+/// `[1P, 3P, 5P, 7P, 1phi(P), 3phi(P), 5phi(P), 7phi(P)]`. Projective
+/// group operations only (cheap additions and endomorphism, no
+/// inversions); the endomorphism multiples are taken via
+/// [`CurveExt::endo`] so they ride along in the caller's normalization.
+fn window_proj<G: GlvOps>(p: &G) -> [G; 8] {
+    let two_p = G::double(p);
+    let mut w = [*p; 8];
+    for i in 1..4 {
+        w[i] = G::add(w[i - 1], two_p);
+    }
+    for i in 0..4 {
+        w[i + 4] = G::endo(&w[i]);
+    }
+    w
+}
+
+/// Assembles a table from one normalized 8-entry window. (`ok().unwrap()`
+/// rather than `expect`, since Aeneas' library proves the length of every
+/// string with `decide +native` and reads `Debug` through an axiom.)
+fn from_window<G: GlvOps>(w: &[G::Affine]) -> G::Table {
+    G::table(
+        w[..4].try_into().ok().unwrap(),
+        w[4..8].try_into().ok().unwrap(),
+    )
+}
+
+/// [`Table::mul`] over the curve operations `G`. Inlined into its callers, as
+/// the method was.
+#[inline]
+fn table_mul_with<G: GlvOps>(t: &G::Table, k: &G::Scalar) -> G {
+    mul_decomposed_with::<G>(t, &decomposed_new_with::<G>(k))
+}
+
+/// [`Table::mul_decomposed`] over the curve operations `G`.
+fn mul_decomposed_with<G: GlvOps>(t: &G::Table, k: &G::Decomposed) -> G {
+    let mut acc = G::identity();
+    let (digits1, digits2, len) = G::digits(k);
+    for i in (0..len).rev() {
+        // `acc` is still the identity on the first iteration; skip the
+        // wasted doubling.
+        if i + 1 < len {
+            acc = G::double(&acc);
         }
+        let (t1, t2) = G::halves(t);
+        add_digit(&mut acc, t1, digits1[i]);
+        add_digit(&mut acc, t2, digits2[i]);
     }
+    acc
 }
 
+/// Adds `d * B` to `acc`, where `table` holds `{1, 3, 5, 7} * B` and `d`
+/// is a signed odd wNAF digit (zero adds nothing).
+fn add_digit<L: LadderOps>(acc: &mut L, table: &[L::Affine; 4], d: i8) {
+    if d != 0 {
+        let mut a = table[(d.unsigned_abs() / 2) as usize];
+        if d < 0 {
+            a = L::neg_affine(a);
+        }
+        L::add_mixed(acc, a);
+    }
+}
