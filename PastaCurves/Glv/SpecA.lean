import PastaCurves.Glv.Funs
import PastaCurves.Glv.Spec

/-!
# Level A: Aeneas' translation of `wnaf_digits` against the model

`Funs.lean` is Aeneas' translation of `wnaf_digits` (`src/glv.rs`, lines 399–419), generated by
`lean/scripts/gen_aeneas.sh`. The translation has the semantics of a debug build: the
`debug_assert!` becomes `massert`, and every `-`, `+`, negation, the write `digits[n] = …` and
`n += 1` is checked, so it fails at the first operation that would panic. The model
(`Model.lean`) instead runs to the end, wrapping as a release build does and recording each check
in a flag (`Wnaf.State.panicsIn`).

WAx says that the two agree exactly: where the model says a debug build panics, the translation
fails, at the assertion; elsewhere it returns the model's `(digits, n)`. WA is the same with the
outcome read as an `Option` (which would not tell a failure from a divergence), and WAok is the
form below `2^127`, which follows from WA and W1. So below `2^127` the translation returns
`Wnaf.run`, whose digits have W3's shape and W4's value and number at most 128 (W2), and from
`2^127` on it fails at the assertion (W1, W6). What W5 and W6 say about builds without debug
assertions or overflow checks concerns the model alone (checked against the Rust by the
differential test); the translation has debug semantics, and in it only the assertion can fail.
-/

namespace PastaCurves.Glv

open Aeneas Aeneas.Std

/-- The translation's digit array read as the model's digits: entry `i` as an integer. -/
def digitsOf (digits : Std.Array Std.I8 128#usize) : Fin 128 → ℤ :=
  fun i => (digits.val.getD i.val 0#i8).val

/-- The translation's return value `(digits, n)` read as the model's. -/
def readOut (r : Std.Array Std.I8 128#usize × Std.Usize) : (Fin 128 → ℤ) × ℕ :=
  (digitsOf r.1, r.2.val)

/-- **WA** (Level A, `wnaf_digits`): on every `u128` magnitude and sign, the translation fails
exactly when the model says a debug build panics, and otherwise returns the model's value. -/
def WA_stmt : Prop :=
  ∀ (a : Std.U128) (neg : Bool),
    (Option.ofResult (pasta_curves.glv.wnaf_digits a neg)).map readOut =
      if (Wnaf.exec a.val neg).panicsIn true true then none else some (Wnaf.run a.val neg)

/-- **WAx** (Level A, exact form): on every `u128` magnitude and sign, where the model says a debug
build panics the translation fails, at the assertion; elsewhere it returns the model's value. It
implies WA and rules out divergence. -/
def WAx_stmt : Prop :=
  ∀ (a : Std.U128) (neg : Bool),
    ((Wnaf.exec a.val neg).panicsIn true true = true →
      pasta_curves.glv.wnaf_digits a neg = .fail .assertionFailure) ∧
    ((Wnaf.exec a.val neg).panicsIn true true = false →
      ∃ r, pasta_curves.glv.wnaf_digits a neg = .ok r ∧ readOut r = Wnaf.run a.val neg)

/-- **WAok** (Level A, below `2^127`): the translation returns, and its value is the model's. It
follows from WA and W1. -/
def WAok_stmt : Prop :=
  ∀ (a : Std.U128) (neg : Bool), a.val < 2 ^ 127 →
    ∃ r, pasta_curves.glv.wnaf_digits a neg = .ok r ∧ readOut r = Wnaf.run a.val neg

end PastaCurves.Glv
